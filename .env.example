# OpenMES — Docker Compose configuration
# Skopiuj do .env i dostosuj wartości:
#   cp .env.example .env
#
# Ten plik NIE trafia do repo (.gitignore).

# ── Domena i HTTPS ────────────────────────────────────────────────────────────
# Produkcja z domeną → Caddy automatycznie pobiera certyfikat Let's Encrypt
# Lokalne testy      → zostaw localhost (HTTP, bez certyfikatu)
DOMAIN=localhost
APP_URL=http://localhost

# ── Tryb pracy ────────────────────────────────────────────────────────────────
# local      → tryb deweloperski (logi debug, błędy na ekranie)
# production → tryb produkcyjny (logi error, błędy ukryte)
APP_ENV=production
APP_DEBUG=false

# ── Application key (Laravel APP_KEY) ────────────────────────────────────────
# The encryption key behind every cookie, session and encrypted column. It has to
# stay the same across restarts: a new key logs everyone out and makes values
# encrypted under the old one permanently undecryptable.
#
# install.sh / install.ps1 generate one and write it here. Left empty, the
# container generates a fresh key on every start instead — it prints a "APP_KEY
# variable is not set" warning from docker compose and re-keys the install each
# time the container is recreated.
#
# Needs to be "base64:" + 32 random bytes (the AES-256-CBC cipher rejects a
# shorter key). To mint one by hand:
#   echo "base64:$(head -c 32 /dev/urandom | base64 | tr -d '\n')"
APP_KEY=

# ── Plant timezone ────────────────────────────────────────────────────────────
# Used by EVERY timestamp: screens, reports, shift boundaries and scheduled jobs.
# Set the plant's timezone, not the server's — otherwise a day's report covers
# different hours than the shift that was worked. Defaults to UTC.
#
# The installer asks for this too, and stores the answer in the database, which is
# what the application reads. That copy wins over this one — deliberately: on
# Docker, compose sets APP_TIMEZONE in the container environment and a real
# environment variable overrides this file, so the wizard could not change it
# otherwise. This value remains the fallback for installs that never ran the
# wizard, and for bare-metal deployments.
APP_TIMEZONE=Europe/Warsaw

# ── Baza danych ───────────────────────────────────────────────────────────────
POSTGRES_DB=openmmes
POSTGRES_USER=openmmes_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ── Sanctum: SPA session auth over /api ───────────────────────────────────────
# Hosts whose requests carry the session cookie instead of getting a 401. The
# live-sync /api/collections reads are session-authenticated, so a host that is
# missing here shows up as empty lists and 401s in the browser console.
#
# Comma-separated. Include the port whenever the app is not on 80/443 — Sanctum
# matches the full "host:port", so `localhost` alone does not cover :8084.
# Add the address you actually open the app on (LAN IP, domain) to the list.
#
# install.sh / install.ps1 fill this in for you. If it is emptied, the app falls
# back to treating its own request host as stateful, which covers any host:port
# with no configuration at all.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ── Konto admina (tworzone automatycznie przy pierwszym starcie) ──────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Leave empty to have the entrypoint mint a strong random password on first boot
# and print it once to the container log — `docker compose logs backend`.
# Set a value to choose your own. Don't put a guessable placeholder here: this
# file is copied verbatim by `cp .env.example .env`, so any value written here
# becomes the real admin password of every install that does not edit it.
ADMIN_PASSWORD=
