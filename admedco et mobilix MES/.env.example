# SQLite database file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Initial accounts created by `npm run db:seed` (and `npm run setup`).
# These are DEMO credentials. Change them before exposing the app beyond
# localhost. Only the seed reads them; editing .env does NOT retroactively
# change accounts that already exist in the database - use the in-app
# Account page (/account) to change a password, or re-run `npm run db:reset`.
SEED_ADMIN_EMAIL="admin@factory.com"
SEED_ADMIN_PASSWORD="Password123!"
SEED_ADMEDCO_EMAIL="admedco@factory.com"
SEED_ADMEDCO_PASSWORD="Password123!"
SEED_MOBILIX_EMAIL="mobilix@factory.com"
SEED_MOBILIX_PASSWORD="Password123!"
